    "liar_game_data": {
        "topic": "The Tiger/Lion Trap",
        "question": "If you see a Tiger in India, what is the most common Hindi word used for it?",
        "options": [
            "Sher (शेर)",
            "Baagh (बाघ)",
            "Cheeta (चीता)",
            "Billa (बिल्ला)"
        ],
        "correct_answer_index": 1,
        "explanation": "While 'Sher' is colloquially used for both Lion and Tiger, in formal Hindi and Indian biology, 'Baagh' (बाघ) is specifically the Tiger (India's national animal) and 'Sher' is the Lion."
    }
