    "liar_game_data": {
        "topic": "The 'Sanganak' Sage",
        "question": "If a technician refers to a 'Sanganak' (संगणक), what complex machine are they talking about?",
        "options": [
            "A calculator",
            "A computer",
            "A satellite",
            "An airplane"
        ],
        "correct_answer_index": 1,
        "explanation": "'Sanganak' is the official and pure Hindi term for a computer. It comes from 'Ganana' (to calculate/compute) and is used in formal governmental and scientific documents."
    }
