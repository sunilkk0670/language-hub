    "liar_game_data": {
        "topic": "The Navrasa Sentiments",
        "question": "In classical Indian poetics, which 'Rasa' (Sentiment) represents 'Pathos' or 'Sorrow'?",
        "options": [
            "Veer Rasa",
            "Karun Rasa",
            "Hasya Rasa",
            "Raudra Rasa"
        ],
        "correct_answer_index": 1,
        "explanation": "'Karun' (करुण) literally means compassionate or pathetic in a literary sense. 'Karun Rasa' is the aesthetic sentiment associated with grief and pity."
    }
