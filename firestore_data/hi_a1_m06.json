    "liar_game_data": {
        "topic": "The 'Ulta-Pulta' Mixup",
        "question": "If someone tells you an item is 'Ulta' (उल्टा), what could that mean besides 'opposite'?",
        "options": [
            "It is very expensive",
            "It is upside down or inside out",
            "It is imported from another country",
            "It is brand new"
        ],
        "correct_answer_index": 1,
        "explanation": "In Hindi, 'Ulta' means opposite, but in daily life, it's the standard word for 'upside down' or 'inside out' (like a t-shirt worn incorrectly). The phrase 'Ulta-Pulta' is often used to describe messy or chaotic situations!"
    }
