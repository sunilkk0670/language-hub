    "liar_game_data": {
        "topic": "The 'Chai-Pani' Code",
        "question": "If an official asks you for 'Chai-Pani' (Tea-Water), what is he most likely asking for in a bureaucratic context?",
        "options": [
            "A refreshment break",
            "A recipe for masala chai",
            "A small bribe or 'speed money'",
            "Directions to the nearest cafeteria"
        ],
        "correct_answer_index": 2,
        "explanation": "In Indian English and Hindi slang, 'Chai-Pani' (literally Tea and Water) is a euphemism for a bribe. It's often presented as a request for 'nominal expenses' for the person's time or effort."
    }
