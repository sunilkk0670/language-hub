    "liar_game_data": {
        "topic": "The 'Kshitij' Horizon",
        "question": "In Hindi poetry, 'Kshitij' (क्षितिज) refers to the horizon. What is the literal Sanskrit meaning of this word?",
        "options": [
            "Born from the sky",
            "Born from the earth",
            "The end of the path",
            "Meeting of gods"
        ],
        "correct_answer_index": 1,
        "explanation": "'Kshitij' is composed of 'Kshiti' (earth) and 'Ja' (born). It literally means 'born from the earth,' describing the point where the sky seems to emerge from the ground."
    }
