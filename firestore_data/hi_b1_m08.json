    "liar_game_data": {
        "topic": "The 'Jaiv-apghataniya' Secret",
        "question": "If a product is labeled as 'Jaiv-apghataniya' (जैव-अपघटनीय), what is its key feature?",
        "options": [
            "It is made of gold",
            "It is biodegradable",
            "It is indestructible",
            "It is toxic"
        ],
        "correct_answer_index": 1,
        "explanation": "'Jaiv' (Bio) + 'Apghataniya' (Degradable). This is the pure Hindi term for biodegradable materials, crucial for ecological policy."
    }
