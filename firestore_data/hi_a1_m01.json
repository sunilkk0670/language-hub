    "liar_game_data": {
        "topic": "The 'Kal' Paradox",
        "question": "In Hindi, if someone says 'Main kal aaunga' (I will come कल), when are they coming?",
        "options": [
            "Yesterday",
            "Tomorrow",
            "Both are possible (context dependent)",
            "Neither"
        ],
        "correct_answer_index": 1,
        "explanation": "The word कल (Kal) is unique because it means both 'yesterday' and 'tomorrow'. The verb tense determines the meaning. 'Aaunga' is future tense, so here it means 'tomorrow'. This is the ultimate context test for Hindi learners!"
    }
