    "liar_game_data": {
        "topic": "The 'Samachar' Flow",
        "question": "The word 'Samachar' (समाचार) for news is formed by combining 'Sama' (equal/balanced) and 'Achar' (conduct). What was the ancient way news was spread?",
        "options": [
            "Through written letters",
            "Through traveling bards (Charan/Bhat)",
            "Through smoke signals",
            "Through bird carriers"
        ],
        "correct_answer_index": 1,
        "explanation": "In ancient India, news and history were primarily spread by 'Charans' or 'Bhats' (traveling bards) who would recite news in the form of poems and songs from village to village."
    }
}