    "liar_game_data": {
        "topic": "The 'Pardukhkatarta' Empathy",
        "question": "What does the extremely high-register word 'Perdukhkatarta' (परदुःखकातरता) literally mean?",
        "options": [
            "Hating others' success",
            "Suffering when others are in pain (Empathy)",
            "Having a poor memory",
            "A fear of public speaking"
        ],
        "correct_answer_index": 1,
        "explanation": "'Per' (Other), 'Dukh' (Suffering), 'Katarta' (Being disturbed/moved). It is the highest formal Hindi term for pure empathy and compassion."
    }
