    "liar_game_data": {
        "topic": "The Barter Trap",
        "question": "The term 'Vastu-vinimay' (वस्तु-विनिमय) refers to an economic system. What is it commonly known as in English?",
        "options": [
            "Digital Banking",
            "Barter System",
            "Cryptocurrency",
            "Tax Collection"
        ],
        "correct_answer_index": 1,
        "explanation": "'Vastu' means object/goods and 'Vinimay' means exchange. Together it perfectly translates to the Barter System where goods are exchanged for goods without money."
    }
