    "liar_game_data": {
        "topic": "The 'Avidya' Illusion",
        "question": "In Indian philosophy, 'Avidya' (अविद्या) is considered the root cause of suffering. What does it literally mean?",
        "options": [
            "Lack of education",
            "Ignorance of the true self",
            "Hate for wisdom",
            "Poor memory"
        ],
        "correct_answer_index": 1,
        "explanation": "'Avidya' is not just a lack of schooling; it is the spiritual ignorance of one's true divine nature, which leads to the cycle of birth and death."
    }
