    "liar_game_data": {
        "topic": "The 'Mridbhaand' Mystery",
        "question": "An archaeologist discovers 'Mridbhaand' (मृद्भाण्ड) at a site. What did they find?",
        "options": [
            "Gold coins",
            "Clay pottery",
            "Iron swords",
            "Stone pillars"
        ],
        "correct_answer_index": 1,
        "explanation": "'Mrit' (Clay) + 'Bhaand' (Vessel). It is the formal Sanskritized term used in archaeology for terra-cotta or earthenware pottery."
    }
