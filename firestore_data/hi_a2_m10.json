    "liar_game_data": {
        "topic": "The 'Laksh(ya)' Confusion",
        "question": "The word 'Lakshya' (लक्ष्य) means target or goal. However, in Sanskrit, the word 'Laksh' (लक्ष) is the root for a specific large number. Which one?",
        "options": [
            "1,000",
            "10,000",
            "100,000",
            "1,000,000"
        ],
        "correct_answer_index": 2,
        "explanation": "'Laksh' (लक्ष) is the Sanskrit root for 100,000, which became the Hindi 'Lakh'. 'Lakshya' (लक्ष्य) means the target or aim one is looking at."
    }
}