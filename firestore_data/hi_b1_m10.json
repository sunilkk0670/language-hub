    "liar_game_data": {
        "topic": "The 'Ativrishti' Weather",
        "question": "If a B1 Hindi news report warns of 'Ativrishti' (अतिवृष्टि), what should you prepare for?",
        "options": [
            "A severe drought",
            "Heavy rainfall and floods",
            "A heatwave",
            "A peaceful sunny day"
        ],
        "correct_answer_index": 1,
        "explanation": "'Ati' means excessive and 'Vrishti' means rain. 'Ativrishti' is the formal term for torrential rain leading to floods, whereas 'Anavrishti' is drought."
    }
