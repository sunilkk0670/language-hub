    "liar_game_data": {
        "topic": "The 'Naadi' Connection",
        "question": "When a traditional Indian doctor (Vaidya) checks your 'Naadi' (नाड़ी), what are they doing?",
        "options": [
            "Checking your breathing",
            "Checking your pulse",
            "Checking your temperature",
            "Checking your throat"
        ],
        "correct_answer_index": 1,
        "explanation": "'Naadi' literally refers to the veins or arteries, but in medical contexts, it specifically means the pulse. 'Naadi Pariksha' (pulse examination) is a core diagnostic method in Ayurveda."
    }
