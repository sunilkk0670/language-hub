    "liar_game_data": {
        "topic": "The 'Vidhivakta' Voice",
        "question": "If you are in a Hindi court and someone introduces themselves as a 'Vidhivakta' (विधिसमया), what is their profession?",
        "options": [
            "A Judge",
            "A Lawyer",
            "A Police Officer",
            "A Court Clerk"
        ],
        "correct_answer_index": 1,
        "explanation": "'Vidhi' means law and 'Vakta' means speaker. A 'Vidhivakta' is a formal and pure Hindi term for an advocate or lawyer, distinct from the more common 'Vakil'."
    }
