    "liar_game_data": {
        "topic": "The 'Nila' Confusion",
        "question": "In Hindi, if a part of the body is described as 'Nila' (नील - Blue) after an injury, what does it mean?",
        "options": [
            "It is healthy",
            "It is bruised",
            "It is cold",
            "It is wet"
        ],
        "correct_answer_index": 1,
        "explanation": "Just like the English 'Black and blue', in Hindi, 'Nila padna' (turning blue) refers to the discoloration of a bruise."
    }
}