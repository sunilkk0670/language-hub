    "liar_game_data": {
        "topic": "The 'Krishna Vivar' Paradox",
        "question": "If you are reading an Indian space research paper and come across the term 'Krishna Vivar' (कृष्ण विवर), what cosmic object is it describing?",
        "options": [
            "A Sun Spot",
            "A Black Hole",
            "A Supernova",
            "The North Star"
        ],
        "correct_answer_index": 1,
        "explanation": "'Krishna' means Black and 'Vivar' means Hole/Void. It is the formal Sanskritized Hindi term for a Black Hole."
    }
