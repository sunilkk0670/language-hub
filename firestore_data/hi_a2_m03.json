    "liar_game_data": {
        "topic": "The 'Lekhani' Tool",
        "question": "In formal Hindi, a pen is referred to as 'Lekhani' (लेखनी). What does the word 'Lekh' (लेख) at its core mean?",
        "options": [
            "To speak",
            "To write",
            "To draw",
            "To listen"
        ],
        "correct_answer_index": 1,
        "explanation": "'Lekhani' comes from the root 'Likh' (to write). It is the formal Sanskritized replacement for the common word 'Kalam', which is of Urdu origin."
    }
}