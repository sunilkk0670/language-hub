    "liar_game_data": {
        "topic": "The 'Bhaiya' Dynamic",
        "question": "If a woman calls a random shopkeeper 'Bhaiya' (Brother), what is the primary social function of this term in India?",
        "options": [
            "She is literally identifying him as her sibling",
            "She is trying to get a discount by acting like family",
            "She is establishing a respectful but non-romantic boundary",
            "She has forgotten his name"
        ],
        "correct_answer_index": 2,
        "explanation": "In Indian culture, family terms like 'Bhaiya' (Brother) or 'Didi' (Sister) are used for strangers to navigate social spaces respectfully. Specifically, for women, it often serves to establish a protective, non-romantic boundary with men in public spaces."
    }
