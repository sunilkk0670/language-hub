    "liar_game_data": {
        "topic": "The 'Lohpathgamini' Train",
        "question": "If you hear someone refer to a train as 'Lohpathgamini' (लोहपथगामिनी), what are they doing?",
        "options": [
            "Using a rare Sanskritized technical term",
            "Referring to a coal ship",
            "Talking about a mountain trail",
            "Referring to a cycle"
        ],
        "correct_answer_index": 0,
        "explanation": "'Lohpathgamini' is the pure Hindi/Sanskrit construction for train (Iron-path-traveler). While rare in speech, it's often used as a humorous example of extreme Hindi formalization."
    }
