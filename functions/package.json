{
  "name": "functions",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsc && mocha lib/test/paddle_webhook.test.js",
    "test:rules": "tsc && mocha --timeout 15000 lib/test/firestore_rules.test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@paddle/paddle-node-sdk": "^1.2.0",
    "firebase-admin": "^11.11.1",
    "firebase-functions": "^7.3.2",
    "jwks-rsa": "^3.2.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.3.0",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "private": true
}
